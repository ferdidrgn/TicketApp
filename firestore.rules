// =============================================================================
// TiyatRol (TicketApp) — Cloud Firestore Güvenlik Kuralları
// =============================================================================
//
// SATIŞ GÜVENLİĞİ (bkz. docs/ODEME-GUVENLIK.md): koltuk, bilet, sipariş ve ücretsiz-bilet
// sayacı yazımı SADECE Cloud Functions (Admin SDK, kuralları atlar) tarafından yapılır.
// İstemci Event.seats / Ticket / Order / UserLimits'e YAZAMAZ. functions/test/rules.test.js
// bu kuralları emülatörde otomatik test eder (npm --prefix functions run test:emulator).
//
// !!! Bu kurallar, mobil uygulamanın ESKİ istemci-taraflı satın alma akışını
// (attemptReservation / confirmPurchase / createTicket) KIRAR. Mobil holdSeats/startPayment/
// confirmFree çağıracak şekilde taşınmadan DEPLOY ETMEYİN (geçiş planı: docs/ODEME-GUVENLIK.md).
//
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Ortak yardımcı fonksiyonlar
    // -------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // GÜVENLİK (S-1, docs/GUVENLIK-DENETIMI.md): anonim olmayan oturum / doğrulanmış telefonlu oturum.
    // Telefon token'ı Firebase Auth SMS doğrulamasından gelir; istemci sahteleyemez.
    function notAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function phoneVerified() {
      return notAnonymous() && request.auth.token.get('phone_number', null) != null;
    }

    // 🔥 UserRole — bkz. lib/core/common/enum/enums.dart:
    //   enum UserRole { admin, curator, user, guest, unknown }
    // User.role, Firestore'a `role.name` ile yazılıyor (bkz. user.dart ->
    // `_userRoleToString`), yani dokümanda tam olarak küçük harfli
    // 'admin' / 'curator' / 'user' / 'guest' / 'unknown' string'i bulunur.
    // NOT: Görev tanımında sadece admin/kullanıcı ayrımı istendi; 'curator'
    // rolüne genel içerik yazma yetkisi BİLİNÇLİ OLARAK verilmedi (ürün
    // gereksinimi netleşirse `|| role == 'curator'` eklenebilir).
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/User/$(request.auth.uid)).data.role == 'admin';
    }

    // User.phoneNumber yazımı: değişmemiş (mevcutla aynı), boş/null, ya da ID token'daki doğrulanmış phone_number ile birebir aynı.
    // `existing` create'te null verilir.
    function phoneNumberWriteOk(existing) {
      let v = request.resource.data.get('phoneNumber', null);
      return v == existing || v == null || v == '' ||
        (request.auth.token.get('phone_number', null) != null && v == request.auth.token.get('phone_number', null));
    }

    // BİLDİRİM TERCİHİ (docs/BILDIRIM-ISTATISTIK.md "Sessizde sesli hatırlatma"): User.notifPrefs yalnızca { loudAlarm: bool } olabilir
    // (kullanıcı kendisi yazar; sunucu yalnız okur). Başka alan/tür reddedilir.
    function notifPrefsOk() {
      let v = request.resource.data.get('notifPrefs', null);
      return v == null || (v is map && v.keys().hasOnly(['loudAlarm']) && v.get('loudAlarm', false) is bool);
    }

    // ÇOKLU CİHAZ PUSH (N-3): User.fcmTokens = bu hesaba bağlı cihazların FCM token'ları (liste, <=5, her biri metin <=4096 karakter).
    function fcmTokensOk() {
      let v = request.resource.data.get('fcmTokens', null);
      return v == null || (v is list && v.size() <= 5 &&
        (v.size() < 1 || (v[0] is string && v[0].size() <= 4096)) &&
        (v.size() < 2 || (v[1] is string && v[1].size() <= 4096)) &&
        (v.size() < 3 || (v[2] is string && v[2].size() <= 4096)) &&
        (v.size() < 4 || (v[3] is string && v[3].size() <= 4096)) &&
        (v.size() < 5 || (v[4] is string && v[4].size() <= 4096)));
    }

    // Hesap silme mezar taşı (AccountDeletion/{uid}.status == 'deleted'|'deleting'): silinen/silinmekte olan uid'in eski ID token'ı
    // (~1 saat geçerli) User belgesini yeniden oluşturamaz/yazamaz. 'pending' (bekleme) kullanıcıyı ENGELLEMEZ (vazgeçebilmeli).
    function deletionLocked(userId) {
      return exists(/databases/$(database)/documents/AccountDeletion/$(userId)) &&
        get(/databases/$(database)/documents/AccountDeletion/$(userId)).data.status in ['deleting', 'deleted'];
    }

    // -------------------------------------------------------------------
    // User — lib/features/users/domain/entities/user.dart
    // Koleksiyon adı: 'User' (bkz. user_remote_data_source_and_impl.dart,
    // docRef = collection('User').doc(user.id) — doküman ID'si = auth uid).
    // -------------------------------------------------------------------
    match /User/{userId} {
      allow read: if isOwner(userId);

      // Create: kullanıcı SADECE kendi uid'siyle kendi dokümanını
      // oluşturabilir (bkz. UserRemoteDataSourceImpl.saveUser, isUpdate:
      // false dalı — zaten var olan bir dokümanın üzerine yazmıyor).
      // GÜVENLİK (26.10.2026): create SIRASINDA da role denetlenir; aksi hâlde yeni kullanıcı
      // User/{uid} belgesini role:'admin' ile oluşturup kendini yönetici yapabilirdi.
      // TELEFON (docs/TELEFON-DOGRULAMA.md): isPhoneActive / phoneVerifiedAt / phoneKey YALNIZCA sunucu (syncPhoneVerification)
      // yazar. İstemci create'te isPhoneActive'i yalnızca false/null/yok, phoneVerifiedAt/phoneKey'i hiç yazamaz; phoneNumber
      // yalnızca boş ya da token'daki doğrulanmış phone_number ile birebir aynı olabilir.
      // HESAP SİLME (docs/HESAP-SILME.md): deletionStatus / deletionScheduledAt / deletionRequestedAt YALNIZCA sunucu yazar.
      allow create: if isOwner(userId) && !deletionLocked(userId) &&
        !('deletionStatus' in request.resource.data) &&
        !('deletionScheduledAt' in request.resource.data) &&
        !('deletionRequestedAt' in request.resource.data) &&
        request.resource.data.get('role', 'user') in ['user', 'guest', 'unknown'] &&
        request.resource.data.get('isPhoneActive', false) in [false, null] &&
        !('phoneVerifiedAt' in request.resource.data) &&
        !('phoneKey' in request.resource.data) &&
        notifPrefsOk() && fcmTokensOk() &&
        phoneNumberWriteOk(null);

      // Update: kendi dokümanını güncelleyebilir AMA 'role' alanını
      // ASLA kendi kendine değiştiremez — aksi halde herhangi bir kullanıcı
      // kendini 'admin' yaparak tüm Show/Event/Stage/... içeriğini
      // değiştirebilirdi (klasik privilege-escalation açığı). role
      // değişimi (ör. birini admin/curator yapmak) bu kural setinde
      // BİLİNÇLİ OLARAK hiçbir client yoluna açılmadı — bu işlem Firebase
      // Console / Admin SDK (custom claim veya doğrudan doküman düzenleme)
      // üzerinden, geliştirici tarafından elle yapılmalı.
      // Update'te de: isPhoneActive değişmedi YA DA false/null'a çekiliyor (true'ya ASLA); phoneVerifiedAt/phoneKey değişmez;
      // phoneNumber değişmedi, boşaltılıyor ya da token'daki doğrulanmış numarayla aynı.
      allow update: if isOwner(userId) && !deletionLocked(userId) &&
        request.resource.data.get('deletionStatus', null) == resource.data.get('deletionStatus', null) &&
        request.resource.data.get('deletionScheduledAt', null) == resource.data.get('deletionScheduledAt', null) &&
        request.resource.data.get('deletionRequestedAt', null) == resource.data.get('deletionRequestedAt', null) &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        (request.resource.data.get('isPhoneActive', null) == resource.data.get('isPhoneActive', null) ||
          request.resource.data.get('isPhoneActive', null) in [false, null]) &&
        request.resource.data.get('phoneVerifiedAt', null) == resource.data.get('phoneVerifiedAt', null) &&
        request.resource.data.get('phoneKey', null) == resource.data.get('phoneKey', null) &&
        notifPrefsOk() && fcmTokensOk() &&
        phoneNumberWriteOk(resource.data.get('phoneNumber', null));

      // Delete: KAPALI (28.10.2026). Hesap silme artık yalnızca sunucuda (requestAccountDeletion -> 30 gün bekleme ->
      // processAccountDeletions): "gelecek biletim varken sil" kuralı istemciden aşılamasın. Admin SDK kuralları atlar.
      allow delete: if false;
    }

    // AccountDeletion — hesap silme işlem günlüğü / kuyruğu. Yalnızca sunucu yazar; yalnız admin okur (düz telefon/e-posta içermez).
    // Kullanıcı kendi durumunu User.deletion* alanlarından ya da getAccountDeletionStatus callable'ından okur.
    match /AccountDeletion/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // Ticket — lib/features/tickets/domain/entities/ticket.dart
    // Koleksiyon adı: 'Ticket' (bkz. ticket_remote_data_source_and_impl.dart)
    // Bilet sahibi `customerId` alanıdır. Client bileti DOĞRUDAN (Cloud
    // Function/Admin SDK aracı OLMADAN) transaction sonrası set() ile
    // yazıyor (bkz. TicketRemoteDataSourceImpl.createTicket ve
    // event_provider.dart -> confirmPurchase sonrası createTicket çağrısı).
    // -------------------------------------------------------------------
    match /Ticket/{ticketId} {
      // Okuma: kendi bileti YA DA admin. getTicketsByCustomerId sorgusu
      // customerId == auth.uid ile filtrelediği için normal kullanıcı
      // akışı bu kuralla uyumludur (Firestore, `where` sorgularında dönen
      // HER dokümanın da read kuralını sağlamasını ister).
      // 🔥 PHASE 2 EKLEMESİ: admin panelinin bilet/koltuk denetim sekmesi
      // (`getTicketsByEventId` — `where('eventId', ...)`) BAŞKA
      // kullanıcılara ait biletleri de döndürür; bu sorgu aynı "her
      // dokümanın read kuralını sağlaması" zorunluluğu yüzünden
      // `|| isAdmin()` olmadan HER ZAMAN permission-denied ile patlardı.
      // Diğer koleksiyonlardaki (`Show`/`Stage`/...) AYNI `isAdmin()`
      // deseni mirror edildi — yeni bir yetki kavramı icat edilmedi.
      allow read: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid || isAdmin());

      // Create: KAPALI. Bilet yalnızca ödeme/onay sunucuda doğrulandıktan sonra Cloud Functions
      // (Admin SDK) tarafından, id = orderId olarak yazılır. (Eski istemci-taraflı createTicket
      // akışı sahte bilet üretimine açıktı.)
      allow create: if false;

      // Update/Delete: bilet sonradan değişmez.
      // İSTİSNA (13.10.2026): admin, "Arşiv" aracıyla eski biletlere SADECE
      // özet alanlarını (oyun adı/afiş/sahne adı/tarih) yazabilir — fiyat,
      // koltuk, sahip gibi hiçbir kritik alan değişemez.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['showName', 'showImageUrl', 'stageName', 'eventDate']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // Notification — lib/features/notifications/domain/entities/
    // app_notification.dart (bu oturumda eklendi). Koleksiyon adı:
    // 'Notification' (bkz. notification_remote_data_source_and_impl.dart).
    // Düz koleksiyon, `userId` alanına göre sorgulanıyor.
    // -------------------------------------------------------------------
    match /Notification/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Create: KAPALI (S-1). Bildirimleri yalnızca sunucu (Admin SDK: sipariş onayı, hatırlatma, duyuru) yazar; mobilde
      // createNotification kullanım durumu hiçbir yerden çağrılmıyor. Aksi halde kullanıcı kendine sınırsız/sahte
      // (ör. sahte "ödeme alındı") bildirim üretip depolamayı şişirebilirdi.
      allow create: if false;

      // Update: tek gerçek kullanım `markNotificationRead` — sadece
      // `isRead` alanını değiştiriyor. Sahipliği (`userId`) veya
      // içeriği (title/body/...) değiştirmeye izin verilmiyor.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.isRead is bool &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      // Delete: kod tabanında kullanılmıyor ama kullanıcının kendi
      // bildirimini silebilmesi (gelen kutusu temizleme) makul bir gelecek
      // özellik — kendi verisi olduğu için risksiz, açık bırakıldı.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // Show / Stage / Team / Player / Campaign — genel/herkese açık içerik.
    // Koleksiyon adları: 'Show', 'Stage', 'Team', 'Player', 'Campaign'
    // (bkz. ilgili *_remote_data_source_and_impl.dart dosyaları).
    // Uygulama GİRİŞ YAPILMADAN (misafir akışı) da gösteri/oyuncu/mekan
    // içeriğini listeleyebilmeli — bu bilinçli bir ürün kararı, bu yüzden
    // okuma herkese açık. Yazma SADECE admin panelinden yapılmalı.
    // -------------------------------------------------------------------
    // -------------------------------------------------------------------
    // Review — oyun yorumu + puan. Belge kimliği `${userId}_${showId}`: bir
    // kullanıcı bir oyuna TEK yorum bırakır. "Yalnızca izleyen yazar" kuralı
    // istemcide (geçmiş bilet) uygulanır; rules bilet sorgulayamaz, bu yüzden
    // burada kimlik, puan aralığı ve metin sınırı zorlanır.
    // GİZLİLİK NOTU: `userName` / `userImage` yorumla birlikte KAMUYA AÇIK gösterilir — bu bilinçli
    // bir ürün kararıdır (yorum yazarken kullanıcı bunu görür). Başka hiçbir kullanıcı verisi buraya yazılmaz.
    // -------------------------------------------------------------------
    match /Review/{reviewId} {
      allow read: if true;

      // Create (S-1): doğrulanmış telefon + anonim olmayan sağlayıcı; alan beyaz listesi, tür ve boyut sınırı; sunucu zamanı;
      // yalnızca var olan bir oyuna; `hidden` istemciden yalnızca false yazılabilir.
      allow create: if phoneVerified() &&
        request.resource.data.keys().hasOnly(['showId', 'userId', 'userName', 'userImage', 'rating', 'text', 'createdAt', 'updatedAt', 'hidden']) &&
        request.resource.data.keys().hasAll(['showId', 'userId', 'rating', 'text', 'hidden', 'createdAt']) &&
        request.resource.data.showId is string &&
        request.resource.data.showId.size() >= 1 && request.resource.data.showId.size() <= 128 &&
        reviewId == request.auth.uid + '_' + request.resource.data.showId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 600 &&
        request.resource.data.get('userName', '') is string && request.resource.data.get('userName', '').size() <= 80 &&
        request.resource.data.get('userImage', '') is string && request.resource.data.get('userImage', '').size() <= 600 &&
        request.resource.data.hidden == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('updatedAt', request.time) == request.time &&
        exists(/databases/$(database)/documents/Show/$(request.resource.data.showId));

      // Sahibi yalnızca puan/metin/ad/foto/zaman alanlarını değiştirir (aynı doğrulamalar); admin ayrıca `hidden` değiştirebilir.
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && phoneVerified() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'text', 'userName', 'userImage', 'updatedAt']) &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 600 &&
          request.resource.data.get('userName', '') is string && request.resource.data.get('userName', '').size() <= 80 &&
          request.resource.data.get('userImage', '') is string && request.resource.data.get('userImage', '').size() <= 600 &&
          request.resource.data.get('updatedAt', request.time) == request.time) ||
        (isAdmin() &&
          request.resource.data.hidden is bool &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hidden']))
      );

      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Şikâyetler (S-1): anonim olmayan oturum; belge kimliği `${reviewId}_${reporterUid}` (mobil ReviewRepository.report ile aynı) ->
    // kullanıcı başına yorum başına TEK belge; alan beyaz listesi + boyut sınırı; var olan yoruma; yalnızca admin okur.
    match /ReviewReport/{reportId} {
      allow create: if notAnonymous() &&
        request.resource.data.keys().hasOnly(['reviewId', 'userId', 'createdAt', 'reason']) &&
        request.resource.data.keys().hasAll(['reviewId', 'userId', 'createdAt']) &&
        request.resource.data.reviewId is string &&
        request.resource.data.reviewId.size() >= 3 && request.resource.data.reviewId.size() <= 300 &&
        reportId == request.resource.data.reviewId + '_' + request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('reason', '') is string && request.resource.data.get('reason', '').size() <= 200 &&
        exists(/databases/$(database)/documents/Review/$(request.resource.data.reviewId));
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /Show/{showId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Stage/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Team/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Player/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Campaign/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 'Seats' koleksiyonu Event.seats ile KARIŞTIRILMAMALI: bu, bir sahnenin
    // statik koltuk DÜZENİ/planıdır (satır -> koltuk etiketleri listesi),
    // bkz. seat_remote_data_source_and_impl.dart (_collection = 'Seats',
    // doküman ID'si = stageId). Sadece
    // `EventRemoteDataSourceImpl.initializeAndGetEventSeats` tarafından
    // OKUNUYOR; kod tabanında client-side hiçbir yazma yok — admin/seed
    // script'i tarafından doldurulduğu varsayılıyor.
    match /Seats/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AppTools: gizlilik politikası / kullanım koşulları gibi statik uygulama
    // ayarları (bkz. app_tools_remote_data_source_and_impl.dart). Kayıt
    // ol/giriş akışından ÖNCE de okunabilmesi gerekiyor (KVKK/kullanım
    // koşulları onayı), bu yüzden herkese açık okuma.
    match /AppTools/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Event — lib/features/events/domain/entities/event.dart
    // Koleksiyon adı: 'Event'. `seats`: Map<seatId, {status, orderId?(opak), holdExpiresAt?, reservedAt?}>.
    // GİZLİLİK: bu belge HERKESE okunur; koltuklarda kullanıcı kimliği (uid/e-posta/ad) TUTULMAZ
    // (yönetici bloğu: status 'blocked'). Sahiplik Order/Ticket üzerinden (yalnızca sahibi okur).
    // Okuma herkese açık (koltuk planı gösterimi). YAZMA SADECE ADMIN:
    // rezervasyon/satın alma yalnızca Cloud Functions (holdSeats/startPayment/confirmFree/
    // iyzicoCallback/expireHolds) üzerinden, Admin SDK ile yapılır; istemci koltuk yazımı KAPALI.
    // -------------------------------------------------------------------
    match /Event/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Order — sipariş (tutma/ödeme durumu). Sadece sahibi OKUR; yazma yalnızca Admin SDK.
    // -------------------------------------------------------------------
    match /Order/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // UserLimits — kullanıcı başına sayaçlar (ücretsiz bilet sayısı, hold hız sınırı).
    // Sahibi okur; yazma yalnızca Admin SDK (aksi halde limit sıfırlanabilirdi).
    // -------------------------------------------------------------------
    match /UserLimits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // Config — herkese açık okunan ayarlar. Config/satis = satış modu:
    //   { mode: 'kapali'|'rezervasyon'|'online', rezervasyonLimit: int, iptalSaat: sayı }
    // Yazma yalnızca admin (ve satis belgesi için şema doğrulamalı). Sunucu her çağrıda okur.
    // -------------------------------------------------------------------
    match /Config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && (docId != 'bildirim' || (
        request.resource.data.autoReminders is bool)) && (docId != 'satis' || (
        request.resource.data.mode in ['kapali', 'rezervasyon', 'online'] &&
        request.resource.data.rezervasyonLimit is int &&
        request.resource.data.rezervasyonLimit >= 0 && request.resource.data.rezervasyonLimit <= 50 &&
        request.resource.data.iptalSaat is number &&
        request.resource.data.iptalSaat >= 0 && request.resource.data.iptalSaat <= 2160));
      allow delete: if false;
    }

    // Stats — görüntülenme sayaçları (trackView yazar, Admin SDK). Yalnız admin okur; istemci yazamaz. Kişisel veri YOK.
    match /Stats/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // NotificationLog — gönderilen bildirimlerin kaydı (adminSendNotification yazar). Yalnız admin okur.
    match /NotificationLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // System — sistem sağlığı kalp atışı (expireHolds / eventReminders yazar, Admin SDK). Yalnızca admin okur.
    match /System/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // TeamManager — EKİP YÖNETİCİSİ yetkisi (docs/EKIP-YONETICISI.md). Belge kimliği `{teamId}_{uid}`.
    // İstemci ASLA yazamaz (atama/geri alma yalnız adminSetTeamManager callable'ı, Admin SDK). Okuma: admin tümünü,
    // yönetici yalnız KENDİ kaydını (sorguda `where('uid','==',auth.uid)` şart). User.role DEĞİŞMEZ; bu rol hiçbir
    // başka koleksiyona yazma/okuma yetkisi vermez (Ticket/Event/Show/Team kuralları değişmedi).
    // TeamManagerLog: atama günlüğü (yalnız admin okur). TeamLimits: yönetici gönderim sayaçları (istemci erişemez).
    // -------------------------------------------------------------------
    match /TeamManager/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /TeamManagerLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /TeamLimits/{uid} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------
    // Varsayılan: yukarıda AÇIKÇA tanımlanmamış her yol için tümüyle kapalı
    // (deny-by-default). Firestore rules zaten eşleşmeyen yollarda örtük
    // olarak reddeder; bu blok niyeti açıkça belgelemek için var.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
