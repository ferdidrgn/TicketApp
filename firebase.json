{
  "hosting": [
    {
      "target": "ana",
      "public": "deploy",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "index, follow"
            }
          ]
        },
        {
          "source": "**/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|svg|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/app",
          "destination": "/app-shell.html"
        },
        {
          "source": "/app/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/discover",
          "destination": "/app-shell.html"
        },
        {
          "source": "/nearby",
          "destination": "/app-shell.html"
        },
        {
          "source": "/profile",
          "destination": "/app-shell.html"
        },
        {
          "source": "/show/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/player/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/stage/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/team/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/search",
          "destination": "/app-shell.html"
        },
        {
          "source": "/settings",
          "destination": "/app-shell.html"
        },
        {
          "source": "/notifications",
          "destination": "/app-shell.html"
        },
        {
          "source": "/favorites",
          "destination": "/app-shell.html"
        },
        {
          "source": "/my-tickets/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/profile-edit/**",
          "destination": "/app-shell.html"
        },
        {
          "source": "/contracts",
          "destination": "/app-shell.html"
        },
        {
          "source": "/help-support",
          "destination": "/app-shell.html"
        },
        {
          "source": "/campaign-details",
          "destination": "/app-shell.html"
        },
        {
          "source": "/login",
          "destination": "/app-shell.html"
        },
        {
          "source": "/phone-login",
          "destination": "/app-shell.html"
        },
        {
          "source": "/onboarding",
          "destination": "/app-shell.html"
        },
        {
          "source": "/seat-selection/**",
          "destination": "/app-shell.html"
        }
      ]
    },
