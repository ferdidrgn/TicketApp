{
  "hosting": [
    {
      "target": "web",
      "public": "site-dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "/yonetim/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/img/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/guvenli-odeme",
          "destination": "/guvenli-odeme.html"
        },
        {
          "source": "/hakkimizda",
          "destination": "/hakkimizda.html"
        },
        {
          "source": "/iletisim",
          "destination": "/iletisim.html"
        },
        {
          "source": "/on-bilgilendirme",
          "destination": "/on-bilgilendirme.html"
        },
        {
          "source": "/iade-iptal",
          "destination": "/iade-iptal.html"
        },
        {
          "source": "/mesafeli-satis",
          "destination": "/mesafeli-satis.html"
        },
        {
          "source": "/rehber/**",
          "destination": "/rehber.html"
        },
        {
          "source": "/rehber",
          "destination": "/rehber.html"
        },
        {
          "source": "/koltuk/**",
          "destination": "/koltuk.html"
        },
        {
          "source": "/odeme-sonuc",
          "destination": "/odeme-sonuc.html"
        },
        {
          "source": "/biletlerim",
          "destination": "/biletlerim.html"
        },
        {
          "source": "/ayarlar",
          "destination": "/ayarlar.html"
        },
        {
          "source": "/takvim",
          "destination": "/takvim.html"
        },
        {
          "source": "/kampanyalar",
          "destination": "/kampanyalar.html"
        },
        {
          "source": "/favoriler",
          "destination": "/favoriler.html"
        },
        {
          "source": "/harita",
          "destination": "/harita.html"
        },
        {
          "source": "/oyun/**",
          "destination": "/oyun.html"
        },
        {
          "source": "/oyuncu/**",
          "destination": "/oyuncu.html"
        },
        {
          "source": "/sahne/**",
          "destination": "/sahne.html"
        },
        {
          "source": "/topluluk/**",
          "destination": "/topluluk.html"
        },
        {
          "source": "/kesfet",
          "destination": "/kesfet.html"
        },
        {
          "source": "/yardim",
          "destination": "/yardim.html"
        },
        {
          "source": "/uygulama",
          "destination": "/uygulama.html"
        },
        {
          "source": "/gizlilik",
          "destination": "/gizlilik.html"
        },
        {
          "source": "/sartlar",
          "destination": "/sartlar.html"
        },
        {
          "source": "/yonetim/**",
          "destination": "/yonetim/index.html"
        }
      ],
      "predeploy": [
        "node site/tools/build.mjs"
      ],
      "redirects": [
        {
          "source": "/privacy.html",
          "destination": "/gizlilik",
          "type": 301
        },
        {
          "source": "/terms.html",
          "destination": "/sartlar",
          "type": 301
        },
        {
          "source": "/app",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/app/**",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/discover",
          "destination": "/kesfet",
          "type": 301
        },
        {
          "source": "/search",
          "destination": "/kesfet",
          "type": 301
        },
        {
          "source": "/nearby",
          "destination": "/harita",
          "type": 301
        },
        {
          "source": "/profile",
          "destination": "/ayarlar",
          "type": 301
        },
        {
          "source": "/settings",
          "destination": "/ayarlar",
          "type": 301
        },
        {
          "source": "/notifications",
          "destination": "/",
          "type": 301
        }
      ]
    }
  ]
}