{
  "hosting": [
    {
      "target": "web",
      "public": "site-dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
            { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://www.google.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://europe-west1-ticketappflutter.cloudfunctions.net; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; frame-src 'self' https://*.firebaseapp.com https://www.google.com https://www.recaptcha.net;" }
          ]
        },
        {
          "source": "/plan/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/ekip",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/yonetim/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/img/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/guvenli-odeme",
          "destination": "/guvenli-odeme.html"
        },
        {
          "source": "/hakkimizda",
          "destination": "/hakkimizda.html"
        },
        {
          "source": "/iletisim",
          "destination": "/iletisim.html"
        },
        {
          "source": "/on-bilgilendirme",
          "destination": "/on-bilgilendirme.html"
        },
        {
          "source": "/iade-iptal",
          "destination": "/iade-iptal.html"
        },
        {
          "source": "/mesafeli-satis",
          "destination": "/mesafeli-satis.html"
        },
        {
          "source": "/rehber/**",
          "destination": "/rehber.html"
        },
        {
          "source": "/rehber",
          "destination": "/rehber.html"
        },
        {
          "source": "/koltuk/**",
          "destination": "/koltuk.html"
        },
        {
          "source": "/plan/**",
          "destination": "/plan.html"
        },
        {
          "source": "/odeme-sonuc",
          "destination": "/odeme-sonuc.html"
        },
        {
          "source": "/pasaport",
          "destination": "/pasaport.html"
        },
        {
          "source": "/biletlerim",
          "destination": "/biletlerim.html"
        },
        {
          "source": "/ayarlar",
          "destination": "/ayarlar.html"
        },
        {
          "source": "/takvim",
          "destination": "/takvim.html"
        },
        {
          "source": "/kampanyalar",
          "destination": "/kampanyalar.html"
        },
        {
          "source": "/favoriler",
          "destination": "/favoriler.html"
        },
        {
          "source": "/harita",
          "destination": "/harita.html"
        },
        {
          "source": "/oyun/**",
          "destination": "/oyun.html"
        },
        {
          "source": "/oyuncu/**",
          "destination": "/oyuncu.html"
        },
        {
          "source": "/sahne/**",
          "destination": "/sahne.html"
        },
        {
          "source": "/topluluk/**",
          "destination": "/topluluk.html"
        },
        {
          "source": "/kesfet",
          "destination": "/kesfet.html"
        },
        {
          "source": "/yardim",
          "destination": "/yardim.html"
        },
        {
          "source": "/uygulama",
          "destination": "/uygulama.html"
        },
        {
          "source": "/gizlilik",
          "destination": "/gizlilik.html"
        },
        {
          "source": "/sartlar",
          "destination": "/sartlar.html"
        },
        {
          "source": "/ekip",
          "destination": "/ekip.html"
        },
        {
          "source": "/yonetim/**",
          "destination": "/yonetim/index.html"
        }
      ],
      "predeploy": [
        "node site/tools/build.mjs"
      ],
      "redirects": [
        {
          "source": "/app",
          "destination": "/vitrin",
          "type": 302
        },
        {
          "source": "/uygulama",
          "destination": "https://play.google.com/store/apps/details?id=com.ferdidrgn.ticketapp",
          "type": 302
        },
        {
          "source": "/privacy.html",
          "destination": "/gizlilik",
          "type": 301
        },
        {
          "source": "/terms.html",
          "destination": "/sartlar",
          "type": 301
        },
        {
          "source": "/discover",
          "destination": "/kesfet",
          "type": 301
        },
        {
          "source": "/search",
          "destination": "/kesfet",
          "type": 301
        },
        {
          "source": "/nearby",
          "destination": "/harita",
          "type": 301
        },
        {
          "source": "/profile",
          "destination": "/ayarlar",
          "type": 301
        },
        {
          "source": "/settings",
          "destination": "/ayarlar",
          "type": 301
        },
        {
          "source": "/notifications",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/show/:slug",
          "destination": "/oyun/:slug",
          "type": 301
        },
        {
          "source": "/player/:slug",
          "destination": "/oyuncu/:slug",
          "type": 301
        },
        {
          "source": "/stage/:slug",
          "destination": "/sahne/:slug",
          "type": 301
        },
        {
          "source": "/team/:slug",
          "destination": "/topluluk/:slug",
          "type": 301
        }
      ]
    },
