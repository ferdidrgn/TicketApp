{
  "name": "tiyatrol-functions",
  "private": true,
  "description": "TiyatRol güvenli bilet satış backend'i (Cloud Functions 2nd gen)",
  "main": "index.js",
  "engines": { "node": "20" },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=60000 test/*.test.js",
    "test:emulator": "firebase emulators:exec --project ticketappflutter --only firestore,auth,functions \"npm test\"",
    "serve": "firebase emulators:start --only firestore,auth,functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
